# Provedor do LLM: openai | anthropic | extractive (offline, sem chave)
LLM_PROVIDER=extractive
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings: openai | hashing (offline, só para demo e testes)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small

# Re-ranking: none | cross-encoder (requer o extra [rerank])
RERANKER=none
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

CHROMA_PATH=.chroma
COLLECTION_NAME=cvm_docs

# Grafo de fundos (requer o extra [graph] e o Neo4j do docker-compose)
GRAPH_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-esta-senha
