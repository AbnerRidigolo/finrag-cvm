# Provedor do LLM: openai | anthropic | extractive (offline, sem chave)
LLM_PROVIDER=extractive
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Juiz da avaliação de respostas (de preferência um modelo diferente do gerador)
JUDGE_PROVIDER=
JUDGE_MODEL=

# Preço em USD por milhão de tokens, {"modelo": [entrada, saída]}.
# Confira os valores atuais nas páginas de preço da OpenAI e da Anthropic antes de usar.
LLM_PRICES={}

# Embeddings: openai | hashing (offline, só para demo e testes)
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small

# Re-ranking: none | cross-encoder (requer o extra [rerank])
RERANKER=none
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# Banco vetorial: chroma (local) | pinecone (requer o extra [pinecone])
VECTOR_STORE=chroma
CHROMA_PATH=.chroma
COLLECTION_NAME=cvm_docs
PINECONE_API_KEY=
PINECONE_INDEX=finrag-cvm
PINECONE_NAMESPACE=cvm-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Grafo de fundos (requer o extra [graph] e o Neo4j do docker-compose)
GRAPH_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=troque-esta-senha
